{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causa.dev/spec/0.1/causa-tape.schema.json",
  "title": "Causa Tape v0.1",
  "type": "object",
  "required": ["format", "metadata", "events", "merkle_root", "signature"],
  "properties": {
    "format": { "const": "0.1" },
    "metadata": {
      "type": "object",
      "required": ["run_id", "created_at", "platform", "mode", "content_policy"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "command": { "type": ["string", "null"] },
        "platform": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "content_policy": { "type": "string", "minLength": 1 },
        "source_run_id": { "type": ["string", "null"] },
        "fork_at": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "kind", "name", "input", "output", "labels", "parents", "hash"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "kind": { "type": "string" },
          "name": { "type": "string" },
          "input": {},
          "output": {},
          "labels": { "type": "array" },
          "parents": { "type": "array", "items": { "type": "string" } },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": true
      }
    },
    "merkle_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": {
      "type": ["object", "null"],
      "properties": {
        "public_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      },
      "required": ["public_key", "signature"]
    }
  },
  "additionalProperties": false
}
